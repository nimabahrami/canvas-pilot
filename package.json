{
  "name": "canvaspilot",
  "version": "0.1.0",
  "private": true,
  "description": "A local screenshot and prompt journal for your desktop.",
  "author": "Nima Bahrami",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimabahrami/canvas-pilot.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-native.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "check:public": "node scripts/check-public-files.mjs",
    "package": "npm run build && npm run build:icons && electron-builder",
    "package:mac": "npm run build && npm run build:icons && electron-builder --mac",
    "package:mac:local": "npm run bundle:mac && node scripts/package-dmg.mjs",
    "package:win": "npm run build && npm run build:icons && electron-builder --win",
    "package:linux": "npm run build && npm run build:icons && electron-builder --linux",
    "bundle:mac": "npm run build && npm run build:icons && node scripts/bundle-mac.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paper-design/shaders-react": "^0.0.82",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.canvaspilot.desktop",
    "productName": "CanvasPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "LICENSES/**/*",
      "build/icon.ico"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "CanvasPilot captures the screen area you select to add to your local prompt journal."
      },
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Nima Bahrami",
      "icon": "build/icons"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
